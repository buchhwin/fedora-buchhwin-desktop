#!/usr/bin/env bash
# buchhwin control — a thin front for the shell's own IPC.
#
# Deliberately small. Anything that needs to know how the desktop works lives
# in QML; this only routes.
set -uo pipefail
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

usage() {
    cat <<'EOF'
bhctl theme [<palette> [<accent>]]   switch or show the colour scheme
bhctl theme apply                    re-render foreign app themes
bhctl wallpaper [<file>]             show or set the wallpaper
bhctl calendar                       check the Google calendar connection
bhctl location [<town>]              show or set where this machine is
bhctl niri apply                     regenerate ~/.config/niri/config.kdl
bhctl niri diff                      show what a regeneration would change
bhctl doctor                         check the installation
bhctl prune                          drop the instance dirs quickshell leaves
bhctl shell reset                    restore default settings and restart
EOF
}

# Quickshell leaves an instance directory behind for EVERY run and never removes
# one. Measured on the test machine after two days: 407 directories, 15 MB, in
# /run/user/<uid> — which is a tmpfs, so it is RAM. Each run adds exactly one.
#
# ⚠️ NOT `flock` ON instance.lock. That is the obvious way to tell a live
# instance from a dead one and it does not work: measured, `flock -n` succeeded
# on all 407 of them INCLUDING the directory belonging to the running shell, so
# a prune built on it would have deleted the live instance's socket out from
# under it.
#
# `qs list` names the instances that are actually alive. Anything else under
# by-id/ belongs to a process that is gone.
prune_instances() {
    local dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/quickshell/by-id"
    [[ -d "$dir" ]] || return 0
    command -v qs >/dev/null || return 0

    local live
    # ⚠️ If the listing itself fails, do NOTHING. An empty answer would
    # otherwise read as "nothing is alive" and take the running shell with it.
    live="$(qs list --all --json 2>/dev/null)" || return 0
    [[ -n "$live" ]] || return 0
    live="$(printf '%s' "$live" | sed -n 's/.*"id": "\([^"]*\)".*/\1/p')"

    local d name
    for d in "$dir"/*/; do
        [[ -d "$d" ]] || continue
        name="$(basename "$d")"
        printf '%s\n' "$live" | grep -qxF "$name" && continue
        rm -rf "$d"
    done
}

# One runner for every tool. This used to be a second copy of the installer's
# render(), with the tool name baked in — so adding a tool meant editing both.
run_tool() {
    local log="/tmp/buchhwin-$1.log"
    BUCHHWIN_TOOL="$1" QT_QPA_PLATFORM=offscreen timeout 60 qs -p "$REPO_DIR/shell" >/dev/null 2>&1
    local code=$?
    # ⚠️ TWO DIFFERENT FAILURES, and this used to see only one of them.
    #
    # A tool that REFUSES exits 0 and says ABORT in its report — that is the
    # designed path, and the report is the only place it shows. A tool that
    # CRASHES says nothing at all, and the exit code was being thrown away
    # here, so a segfault came back as success while the log still held the
    # previous run's cheerful "done". lib/common.sh has always checked the
    # code; this is the copy that did not.
    if (( code != 0 )); then
        echo "$1 crashed or timed out (exit $code) — see $log" >&2
        [[ -f "$log" ]] && tail -3 "$log" >&2
        return 1
    fi
    if grep -q ABORT "$log" 2>/dev/null; then
        sed -n '/ABORT/,$p' "$log" >&2
        return 1
    fi
    prune_instances
    return 0
}
render() { run_tool render; }

case "${1:-}" in
theme)
    shift
    case "${1:-}" in
    ""|show)
        jq -r '.theme | "palette: \(.palette)  accent: \(.accent)"' \
            "$CONFIG_HOME/buchhwin/shell.json" 2>/dev/null || echo "no settings yet"
        # index.txt is GENERATED by the installer and gitignored, so any deploy
        # that syncs the repo with --delete removes it. Falling back to the
        # directory itself means `bhctl theme` never reports "no palettes" on a
        # machine that plainly has eleven of them.
        printf 'available: '
        if [[ -s "$REPO_DIR/shell/theme/palettes/index.txt" ]]; then
            tr '\n' ' ' < "$REPO_DIR/shell/theme/palettes/index.txt"
        else
            ( cd "$REPO_DIR/shell/theme/palettes" && ls -1 ./*.json 2>/dev/null \
                | sed 's|^\./||; s|\.json$||' | tr '\n' ' ' )
        fi
        echo
        ;;
    apply) render && echo "themes re-rendered" ;;
    *)
        pal="$1"; accent="${2:-}"
        [[ -f "$REPO_DIR/shell/theme/palettes/$pal.json" ]] || { echo "no such palette: $pal" >&2; exit 1; }
        [[ -n "$accent" ]] || accent="$(jq -r '.accents[0]' "$REPO_DIR/shell/theme/palettes/$pal.json")"
        f="$CONFIG_HOME/buchhwin/shell.json"
        tmp="$(mktemp)"
        jq --arg p "$pal" --arg a "$accent" '.theme.palette=$p | .theme.accent=$a' "$f" > "$tmp" \
            && mv "$tmp" "$f"
        render
        echo "palette: $pal  accent: $accent"
        ;;
    esac
    ;;
location)
    shift
    f="$CONFIG_HOME/buchhwin/shell.json"
    case "${1:-}" in
    ""|show)
        jq -r '.location // {} | if .name then
                 "place:  \(.name)\ncoords: \(.lat), \(.lon)\nsource: \(.source // "unknown")"
               else "nothing set" end' "$f" 2>/dev/null || echo "no settings yet"
        # Where the guess would come from, so "nothing set" is actionable.
        printf 'timezone: %s\n' "$(timedatectl show -p Timezone --value 2>/dev/null)"
        ;;
    *)
        town="$*"
        # The same geocoder the shell uses. No API key, which is the only
        # reason this works without a setup step.
        r="$(curl -s --max-time 10 "https://geocoding-api.open-meteo.com/v1/search?count=1&language=de&format=json&name=$(jq -rn --arg t "$town" '$t|@uri')")"
        name="$(jq -r '.results[0].name // empty' <<<"$r")"
        [[ -n "$name" ]] || { echo "no such place: $town" >&2; exit 1; }
        country="$(jq -r '.results[0].country // empty' <<<"$r")"
        lat="$(jq -r '.results[0].latitude' <<<"$r")"
        lon="$(jq -r '.results[0].longitude' <<<"$r")"
        tmp="$(mktemp)"
        jq --arg n "$name${country:+, $country}" --argjson la "$lat" --argjson lo "$lon" \
           '.location = {name: $n, lat: $la, lon: $lo, source: "manual"}' "$f" > "$tmp" \
            && mv "$tmp" "$f"
        echo "place: $name${country:+, $country}  ($lat, $lon)"
        ;;
    esac
    ;;
calendar)
    # Deliberately its own busctl calls rather than asking the shell: when the
    # calendar is empty the first question is whether the ACCOUNT is there, and
    # that has to be answerable with the shell dead.
    objs="$(busctl --user --json=short call org.gnome.OnlineAccounts \
             /org/gnome/OnlineAccounts org.freedesktop.DBus.ObjectManager \
             GetManagedObjects 2>/dev/null)"
    if [[ -z "$objs" ]]; then
        echo "online accounts are not answering (is goa-daemon running?)" >&2
        exit 1
    fi

    path="$(jq -r '.data[0] | to_entries[]
            | select(.value["org.gnome.OnlineAccounts.Account"].ProviderType.data == "google")
            | select(.value["org.gnome.OnlineAccounts.Account"].CalendarDisabled.data != true)
            | .key' <<<"$objs" | head -1)"

    if [[ -z "$path" ]]; then
        echo "no Google account with the calendar switched on"
        echo "add one with: gnome-online-accounts-gtk"
        exit 1
    fi

    name="$(jq -r --arg p "$path" '.data[0][$p]["org.gnome.OnlineAccounts.Account"].PresentationIdentity.data' <<<"$objs")"
    echo "account:  $name"
    echo "path:     $path"

    tok="$(busctl --user --json=short call org.gnome.OnlineAccounts "$path" \
           org.gnome.OnlineAccounts.OAuth2Based GetAccessToken 2>/dev/null)"
    if [[ -z "$tok" ]]; then
        echo "token:    REFUSED — reconnect the account" >&2
        exit 1
    fi
    # The token itself is never printed. It is a bearer credential, and a
    # diagnostic that leaks one is worse than no diagnostic.
    echo "token:     ok, valid for $(jq -r '.data[1]' <<<"$tok")s"

    url="https://apidata.googleusercontent.com/caldav/v2/$name/events/"
    code="$(curl -s -o /dev/null -w '%{http_code}' -X PROPFIND -H "Depth: 0" \
            -H "Authorization: Bearer $(jq -r '.data[0]' <<<"$tok")" "$url" 2>/dev/null)"
    echo "calendar:  HTTP $code  $url"
    [[ "$code" == "207" || "$code" == "200" ]] && echo "reachable" || echo "NOT reachable"
    ;;
wallpaper)
    shift
    f="$CONFIG_HOME/buchhwin/shell.json"
    case "${1:-}" in
    ""|show)
        jq -r '.wallpaper.current // "none"' "$f" 2>/dev/null || echo "no settings yet"
        ;;
    *)
        img="$1"
        [[ -f "$img" ]] || { echo "no such file: $img" >&2; exit 1; }
        # An ABSOLUTE file:// URL, because that is what the shell stores and
        # what Image.source needs. A bare relative path would resolve against
        # whatever directory the shell happened to start in.
        url="file://$(readlink -f "$img")"
        tmp="$(mktemp)"
        jq --arg u "$url" '.wallpaper.current=$u' "$f" > "$tmp" && mv "$tmp" "$f"
        echo "wallpaper: $url"
        # ⚠️ ONLY WHEN THERE IS NO SHELL, and that was the whole of the "two
        # render runs per wallpaper change" report.
        #
        # A running shell watches shell.json, re-derives the palette and its
        # theming service renders — measured, four changes out of four, one run
        # each. Doing it here as well meant THREE offscreen quickshell
        # processes for one picture: wallpaper-palette, our render, and the
        # shell's. No debounce can merge those; they are in different
        # processes, and the second is not a rebound but a duplicate.
        #
        # The unit is the question, not `pgrep qs`: the renderer itself is a
        # `qs`, so a process check would answer yes to its own reflection.
        if systemctl --user is-active --quiet buchhwin-shell; then
            echo "  the running shell re-derives and re-renders by itself"
            echo "  (bhctl theme apply forces one, if you want it now)"
        else
            # No shell: rebuild the derived palette and rewrite GTK, Qt, kitty
            # and niri from it, or nothing would happen at all.
            run_tool wallpaper-palette && render
            # A refusal is not a failure — the image is set, it just cannot make
            # a readable scheme, so the previous one stays. Say so instead of
            # letting the colours quietly not change.
            if grep -q REFUSED /tmp/buchhwin-wallpaper-palette.log 2>/dev/null; then
                grep REFUSED /tmp/buchhwin-wallpaper-palette.log >&2
                echo "  the colour scheme was left as it was" >&2
            fi
        fi
        ;;
    esac
    ;;
niri)
    shift
    cfg="$CONFIG_HOME/niri/config.kdl"
    case "${1:-apply}" in
    apply)
        mkdir -p "$CONFIG_HOME/niri" "$CONFIG_HOME/environment.d"
        run_tool niri || exit 1
        if command -v niri >/dev/null; then
            # niri live-reloads on write, so a broken file is already loaded by
            # the time we get here. Say so loudly rather than let it look fine.
            if niri validate -c "$cfg" 2>&1 | grep -q "config is valid"; then
                echo "config.kdl regenerated and valid"
            else
                echo "config.kdl regenerated but INVALID:" >&2
                niri validate -c "$cfg" 2>&1 | sed 's/^/  /' >&2
                exit 1
            fi
        else
            echo "config.kdl regenerated (niri not installed, not validated)"
        fi
        ;;
    diff)
        tmp="$(mktemp -d)"; mkdir -p "$tmp/niri" "$tmp/environment.d"
        XDG_CONFIG_HOME="$tmp" run_tool niri || { rm -rf "$tmp"; exit 1; }
        # ⚠️ PUT THE REAL CONFIG HOME BACK BEFORE COMPARING, or this never says
        # "no changes". The generator writes absolute paths out of
        # XDG_CONFIG_HOME — `LG_CONFIG_FILE` is one — and this runs it against a
        # temporary directory, so that line differed on every single run
        # regardless of whether anything had actually changed.
        #
        # It went unnoticed because nothing depended on the answer until
        # `doctor` started asking. A comparison that always reports a difference
        # is the same as no comparison at all.
        sed -i "s|$tmp|$CONFIG_HOME|g" "$tmp/niri/config.kdl"
        if diff -u "$cfg" "$tmp/niri/config.kdl" 2>/dev/null; then
            echo "no changes"
        fi
        rm -rf "$tmp"
        ;;
    *) usage; exit 2 ;;
    esac
    ;;
binds)
    # ⚠️ THE ONE HANDLE THAT UNFREEZES A MACHINE. `doctor` can only report that
    # shell.json carries its own copy of the key bindings; this removes it, and
    # from then on the built-in set applies again — including every key added
    # since the file was written.
    #
    # ⚠️ It DELETES a key from his settings file, so it says what it is about to
    # do and only does it when asked by name. Anything he bound himself is in
    # that list too, and there is no way to tell his entries from the frozen
    # ones — see Migrations.qml step 7 -> 8, which only removes the list when
    # every single entry is one of ours.
    case "${2:-}" in
    reset)
        cfg="$CONFIG_HOME/buchhwin/shell.json"
        [[ -f "$cfg" ]] || { echo "no shell.json — nothing to reset"; exit 0; }
        python3 - "$cfg" <<'PYEOF'
import json, os, sys
path = sys.argv[1]
with open(path) as fh:
    cfg = json.load(fh)
n = len(cfg.get("binds") or [])
if not n:
    print("binds: already the built-in set — nothing to do")
    raise SystemExit(0)
del cfg["binds"]
tmp = path + ".buchhwin-tmp"
with open(tmp, "w") as fh:
    json.dump(cfg, fh, indent=2)
    fh.write("\n")
os.replace(tmp, path)
print("binds: removed %d frozen entries — the built-in set applies again" % n)
PYEOF
        # The generator has to run, or the file is right and the compositor
        # still has yesterday's config. This is the half people forget.
        exec "$0" niri apply
        ;;
    *)  echo "usage: bhctl binds reset" >&2; exit 2 ;;
    esac
    ;;

doctor)
    printf 'niri        %s\n' "$(niri --version 2>/dev/null | head -1 || echo MISSING)"
    printf 'quickshell  %s\n' "$(qs --version 2>/dev/null | cut -d, -f1 || echo MISSING)"
    printf 'shell unit  %s\n' "$(systemctl --user is-active buchhwin-shell 2>/dev/null || echo inactive)"
    printf 'config      %s\n' "$([[ -f $CONFIG_HOME/buchhwin/shell.json ]] && echo ok || echo MISSING)"
    if [[ -f "$CONFIG_HOME/niri/config.kdl" ]]; then
        if command -v niri >/dev/null && niri validate -c "$CONFIG_HOME/niri/config.kdl" 2>&1 | grep -q "config is valid"; then
            printf 'niri config valid (%s lines)\n' "$(wc -l < "$CONFIG_HOME/niri/config.kdl")"
        else
            printf 'niri config INVALID — run: bhctl niri apply\n'
        fi
    else
        printf 'niri config MISSING — run: bhctl niri apply\n'
    fi
    # ─────────────────────────────────────────────────────────────────────
    # ⚠️ IS THIS MACHINE STILL LISTENING TO THE DEFAULTS?
    #
    # He reported on 07.08.2026 that Super+F does not toggle fullscreen and that
    # the window title bars are still there. Both work on a fresh install —
    # `Mod+F` is bound, `toggle-windowed-fullscreen` is a real niri action, the
    # generated config validates, and `prefer-no-csd` is in it. So the fault is
    # not in the code; it is that HIS machine never received them.
    #
    # There are exactly two ways that happens, and neither says a word on its
    # own. This is where they get to.
    cfg="$CONFIG_HOME/buchhwin/shell.json"
    kdl="$CONFIG_HOME/niri/config.kdl"

    if [[ -f "$cfg" ]]; then
        # ⚠️ ONE: a `binds` array in shell.json FREEZES the keys for ever.
        # It should not be there at all. It got there when `keys.binds` was a
        # `var` inside a nested JsonObject and carried the defaults as its own
        # default value — so the file was written with all 63 of them in it.
        # "The file wins as soon as it says anything" then means every LATER
        # default is ignored: a key added months afterwards simply never
        # appears. That is the whole of his fullscreen report.
        n_binds="$(python3 -c "
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: print(-1); raise SystemExit
b=d.get('binds')
print(len(b) if isinstance(b,list) else 0)" "$cfg" 2>/dev/null || echo -1)"
        if [[ "$n_binds" == "-1" ]]; then
            printf 'binds       shell.json is not readable as JSON\n'
        elif [[ "$n_binds" == "0" ]]; then
            printf 'binds       ok (the built-in set)\n'
        else
            printf 'binds       FROZEN: %s in shell.json — new keys will NEVER appear\n' "$n_binds"
            printf '            run: bhctl binds reset\n'
        fi

        # TWO: the generated config does not match the settings it came from.
        # A `bhctl theme apply` does not rewrite config.kdl, and neither does
        # copying the repo across — only `bhctl niri apply` does.
        #
        # ⚠️ THE CONTENT, NOT THE TIMESTAMP. The first version compared mtimes,
        # and it cried wolf immediately: `bhctl binds reset` writes shell.json
        # and then regenerates — but the generator does not rewrite a file whose
        # content is unchanged, so config.kdl keeps its old mtime and looked
        # stale while being perfectly current. A check that is wrong when
        # everything is fine gets ignored the day it is right, which is the same
        # failure the hand-typed verb list in tools/smoke.qml had this week.
        #
        # `bhctl niri diff` already answers the real question: generate into a
        # temporary directory and compare. Reusing it also means the two can
        # never disagree.
        if [[ -f "$kdl" ]]; then
            if [[ -n "$("$0" niri diff 2>/dev/null | grep -v '^no changes$')" ]]; then
                printf 'niri config STALE — it does not match shell.json\n'
                printf '            run: bhctl niri apply   (see: bhctl niri diff)\n'
            else
                printf 'niri config ok (matches shell.json)\n'
            fi
            # And the two things he named, checked directly rather than implied.
            grep -q "Mod+F " "$kdl" \
                && printf 'Mod+F       ok (in config.kdl)\n' \
                || printf 'Mod+F       MISSING from config.kdl — run: bhctl niri apply\n'
            grep -q "prefer-no-csd" "$kdl" \
                && printf 'no title bar ok (prefer-no-csd in config.kdl)\n' \
                || printf 'no title bar MISSING — run: bhctl niri apply\n'
        fi
    fi
    # ─────────────────────────────────────────────────────────────────────

    # ⚠️ The SERVICE line, not the first line containing an "@". systemd-analyze
    # prints two sentences of explanation first — and one of them contains the
    # word "@" — so the old grep reported "The time when unit became active or
    # started is printed after the @ character" as though it were a measurement.
    # A number that is not a number is worse than no number.
    printf 'startup     %s\n' "$(systemd-analyze --user critical-chain buchhwin-shell.service 2>/dev/null | grep -m1 '^buchhwin-shell\.service' | sed 's/^ *//' || echo 'not measured')"
    # ⚠️ THE PRICE OF THE TWO COPRs, paid where it can be seen.
    #
    # starship and lazygit are the only two packages here that Fedora does not
    # ship, and taking a COPR means taking on somebody else's repository going
    # away. That risk was accepted on the condition that it says so out loud
    # rather than leaving two programs quietly missing after an update.
    for pair in "starship:atim/starship" "lazygit:atim/lazygit"; do
        p="${pair%%:*}"; repo="${pair##*:}"
        if command -v "$p" >/dev/null 2>&1; then
            # ⚠️ Cut to the version itself. lazygit --version answers with a
            # whole line of build metadata — "commit=, build date=, build
            # source=unknown, version=0.47.2, os=linux…" — and a doctor report
            # that is mostly noise is a report nobody reads to the end.
            printf '%-11s %s\n' "$p" "$("$p" --version 2>/dev/null | head -1 \
                | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)"
        elif dnf repoquery --qf '%{name}' "$p" >/dev/null 2>&1 &&
             [[ -n "$(dnf repoquery --qf '%{name}' "$p" 2>/dev/null)" ]]; then
            printf '%-11s MISSING but available — sudo dnf install %s\n' "$p" "$p"
        else
            printf '%-11s MISSING and the copr %s does not resolve\n' "$p" "$repo"
        fi
    done
    # Every generated theme needs something pointing at it. This is the same
    # question tests/reachable.sh asks, asked on the machine you are sitting at.
    miss=""
    grep -qE '^ *include  *theme\.conf' "$CONFIG_HOME/kitty/kitty.conf" 2>/dev/null || miss+=" kitty"
    grep -q 'colors/buchhwin\.conf' "$CONFIG_HOME/qt6ct/qt6ct.conf" 2>/dev/null || miss+=" qt6ct"
    grep -qE '^color_theme *= *"buchhwin"' "$CONFIG_HOME/btop/btop.conf" 2>/dev/null || miss+=" btop"
    grep -q 'buchhwin\.toml' "$CONFIG_HOME/alacritty/alacritty.toml" 2>/dev/null || miss+=" alacritty"
    grep -q 'buchhwin\.conf' "$CONFIG_HOME/tmux/tmux.conf" 2>/dev/null || miss+=" tmux"
    grep -q 'buchhwin' "$CONFIG_HOME/bat/config" 2>/dev/null || miss+=" bat"
    grep -q 'buchhwin-delta' "$CONFIG_HOME/git/config" 2>/dev/null || miss+=" delta"
    if [[ -n "$miss" ]]; then
        printf 'theming     no pointer for:%s (their colours never arrive)\n' "$miss"
    else
        printf 'theming     every generated theme is pointed at\n'
    fi
    # Two things that are invisible until they are counted.
    #
    # A second shell draws its own bar and its own notch on top of the first
    # one's, and looks exactly like the first one behaving strangely — which is
    # how a stray instance went unnoticed here for half an hour of debugging.
    shells=$(pgrep -c -x qs 2>/dev/null || echo 0)
    if (( shells > 1 )); then
        printf 'shell       \033[38;5;203m%s instances running\033[0m — one of them is a stray\n' "$shells"
    fi

    # And the directories quickshell leaves behind, in a tmpfs, one per run.
    inst=$(ls "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/quickshell/by-id" 2>/dev/null | wc -l)
    if (( inst > 20 )); then
        printf 'instances   %s directories left behind — run `bhctl prune`\n' "$inst"
    else
        printf 'instances   %s directory(ies), nothing to clean up\n' "$inst"
    fi

    # "as little XWayland as possible" is only a claim until something counts.
    if command -v niri >/dev/null && niri msg -j windows >/dev/null 2>&1; then
        if pgrep -x Xwayland >/dev/null 2>&1; then
            printf 'xwayland    RUNNING — these windows are not Wayland-native:\n'
            command -v xlsclients >/dev/null && xlsclients 2>/dev/null | sed 's/^/            /'
        else
            printf 'xwayland    not running (every window is Wayland-native)\n'
        fi
    fi
    ;;
"prune")
    # Called by buchhwin-shell.service before every start, and by hand. The
    # numbers are printed because a cleanup that says nothing is one nobody can
    # tell apart from a cleanup that did nothing.
    d="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/quickshell/by-id"
    before=$(ls "$d" 2>/dev/null | wc -l)
    prune_instances
    after=$(ls "$d" 2>/dev/null | wc -l)
    echo "quickshell instance directories: $before → $after"
    ;;

"shell")
    [[ "${2:-}" == "reset" ]] || { usage; exit 2; }
    cp "$CONFIG_HOME/buchhwin/shell.json" "$CONFIG_HOME/buchhwin/shell.json.bak" 2>/dev/null
    # ⚠️ NO "version" KEY, deliberately. This used to write 1 while the
    # installer wrote 2 and the code said 3 — three places claiming to know the
    # schema version, two of them wrong. A file without one reads as 0 and is
    # migrated forward, which is the same path a genuinely old file takes, so
    # the only place that has to know the number is the code.
    printf '{\n  "theme": { "palette": "everforest-dark", "accent": "green" }\n}\n' \
        > "$CONFIG_HOME/buchhwin/shell.json"
    systemctl --user restart buchhwin-shell 2>/dev/null
    echo "settings reset (previous kept as shell.json.bak)"
    ;;
*) usage ;;
esac
